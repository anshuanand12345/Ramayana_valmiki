# ---- Server ----
NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:5173

# ---- Database ----
# MongoDB Atlas connection string (free M0 cluster): https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=ramayana_guide

# ---- LLM (any OpenAI-compatible endpoint) ----
# Google Gemini free tier — key from https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# OpenAI (paid) instead:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1
# LLM_FAST_MODEL=gpt-4.1-mini
# Groq free tier instead:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# ---- Embeddings ----
# local = bge-small-en-v1.5 runs in-process (no key, no rate limits).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
EMBEDDING_DIM=384

# ---- Reranker (optional) ----
# Free trial key from https://dashboard.cohere.com/api-keys — enables cross-encoder reranking.
COHERE_API_KEY=

# ---- Usage limits (each question costs LLM tokens) ----
DAILY_QUESTIONS_PER_VISITOR=5
DAILY_QUESTIONS_SITE_WIDE=200

# ---- Pipeline switches ----
ENABLE_HYDE=true
ENABLE_CRAG=true
