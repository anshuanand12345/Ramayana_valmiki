{
  "name": "ramayana-guide-backend",
  "version": "1.0.0",
  "description": "Advanced RAG API over the Valmiki Ramayana (hybrid search, HyDE, reranking, corrective RAG)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:indexes": "node src/db/indexes.js",
    "ingest:extract": "node scripts/ingest/1-extract.js",
    "ingest:parse": "node scripts/ingest/2-parse.js",
    "ingest:load": "node scripts/ingest/3-embed-load.js",
    "ingest": "npm run ingest:extract && npm run ingest:parse && npm run ingest:load",
    "models:download": "node scripts/download-models.js",
    "test": "NODE_ENV=test MONGODB_URI=mongodb://localhost/test node --test tests/*.test.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "mongodb": "^7.8.0",
    "openai": "^7.54.0",
    "pdfjs-dist": "^4.10.38",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  }
}
